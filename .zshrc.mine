#autojump
[[ -s `brew --prefix`/etc/autojump.sh ]] && . `brew --prefix`/etc/autojump.sh

#for zsh-completions
fpath=(/usr/local/share/zsh-completions $fpath)

path=(
		~/opt/*/(s|)bin(N-/)
		/opt/*/(s|)bin(N-/)
		$path
)

manpath=(
	~/opt/share/man(N-/)
)



#pylearn2
export PYLEARN2_DATA_PATH=$HOME/Documents/pylearn2
export PYLEARN2_VIEWER_COMMAND="open -Wn"

# Add environment variable COCOS_CONSOLE_ROOT for cocos2d-x
export COCOS_CONSOLE_ROOT=/Users/NagataShohei/cocos2d-x/tools/cocos2d-console/bin
export PATH=$COCOS_CONSOLE_ROOT:$PATH

# Add environment variable NDK_ROOT for cocos2d-x
export NDK_ROOT=/Users/NagataShohei/android-ndk
export PATH=$NDK_ROOT:$PATH

# Add environment variable ANDROID_SDK_ROOT for cocos2d-x
export ANDROID_SDK_ROOT=/Applications/Android SDK
export PATH=$ANDROID_SDK_ROOT:$PATH
export PATH=$ANDROID_SDK_ROOT/tools:$ANDROID_SDK_ROOT/platform-tools:$PATH

# Add environment variable ANT_ROOT for cocos2d-x
export ANT_ROOT=/usr/local/bin
export PATH=$ANT_ROOT:$PATH

#julia
export PATH=$PATH:/Applications/Julia-0.3.2.app/Contents/Resources/julia/bin

#adb etc.
export PATH=$PATH:/Applications/Android\ SDK/platform-tools


#~env
export PATH="$HOME/.rbenv/bin:$PATH"
eval "$(rbenv init -)"
eval "$(plenv init -)"
#pyenv
export PYENV_ROOT="${HOME}/.pyenv"
if [ -d "${PYENV_ROOT}" ]; then
    export PATH=${PYENV_ROOT}/bin:$PATH
    eval "$(pyenv init -)"
fi

