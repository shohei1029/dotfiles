# macOS
.DS_Store

.python-version

# secrets — use .env.example as the template
.env

# machine-local shell overrides (sourced last by .zshrc / .bashrc)
.zshrc.local
.bashrc.local

# antidote (plugin manager): cloned plugins and generated bundle
.antidote/
.zsh_plugins.zsh

# zcompile output (regenerated on shell startup)
.zshrc.zwc
