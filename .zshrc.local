alias emacs='sl'
alias brewup='brew upgrade && brew cleanup'

alias pbcopy='clip.exe'

path=($path $HOME/bin(N-/))

eval $(/home/linuxbrew/.linuxbrew/bin/brew shellenv)
eval "$(anyenv init -)"

source "$HOME/.rye/env"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/shohei/.anyenv/envs/pyenv/versions/anaconda3-2023.03/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/shohei/.anyenv/envs/pyenv/versions/anaconda3-2023.03/etc/profile.d/conda.sh" ]; then
        . "/home/shohei/.anyenv/envs/pyenv/versions/anaconda3-2023.03/etc/profile.d/conda.sh"
    else
        export PATH="/home/shohei/.anyenv/envs/pyenv/versions/anaconda3-2023.03/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

