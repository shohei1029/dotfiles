# .zshrc.linux — native Linux specific settings.
# Loaded automatically from .zshrc when running on native Linux (non-WSL).
# WSL has its own .zshrc.wsl; macOS has .zshrc.mac.

alias brewup='brew upgrade && brew cleanup'

# Linuxbrew (Homebrew on Linux) の初期化は .zshrc 本体で
# クロスプラットフォームに行う (antidote より前に PATH へ載せる必要があるため)。

export PATH="$HOME/.local/bin:$PATH"
path=($path $HOME/bin(N-/))
